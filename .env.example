# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ELEVENLABS_API_KEY=
KAGGLE_USERNAME=
